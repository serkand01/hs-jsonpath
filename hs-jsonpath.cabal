cabal-version: 3.0
name:          hs-jsonpath
version:       0.2.0.0
synopsis:      JSONPath query engine for Haskell
license:       MIT
license-file:  LICENSE
author:        Serkan Demir
build-type:    Simple

library
  exposed-modules:
    Data.JSONPath
    Data.JSONPath.Parser
    Data.JSONPath.Eval
    Data.JSONPath.Types
  build-depends:
    base       >= 4.17 && < 5,
    aeson      >= 2.1,
    text       >= 2.0,
    vector     >= 0.13,
    containers >= 0.6,
    megaparsec >= 9.0
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -O2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base,
    hs-jsonpath,
    hspec >= 2.10,
    aeson
  default-language: Haskell2010
